{
  "name": "my-media-universe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "My Media Universe — a private, personal media library and viewing journal (Persian, RTL, PWA)",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"wrangler dev --port 8787 --local\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev --port 8787 --local",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply mmu-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mmu-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "db:reset:local": "bash scripts/reset-local-db.sh",
    "smoke": "node --experimental-strip-types scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.2.5",
    "@tanstack/react-query": "^5.62.0",
    "hono": "^4.6.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.0.5",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
