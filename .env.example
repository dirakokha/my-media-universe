### Cloudflare Worker secrets — never commit .dev.vars
# Copy to .dev.vars for local development.
TMDB_API_KEY=your_tmdb_v4_read_access_token
TMDB_API_BASE_URL=https://api.themoviedb.org/3
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_DRIVE_FOLDER_NAME=My Media Universe
APP_BASE_URL=http://localhost:8787
# 32-byte base64 key used to encrypt Google refresh tokens at rest (openssl rand -base64 32)
ENCRYPTION_KEY=change_me_base64_32_bytes
# Set to a real provider key in production (Resend). In development the app logs codes instead.
RESEND_API_KEY=
EMAIL_FROM=My Media Universe <no-reply@example.com>
# Bootstrap secret for creating the first administrator. Remove after first admin exists.
ADMIN_BOOTSTRAP_SECRET=change_me_long_random_string
# Set to production when deploying
ENV=development
